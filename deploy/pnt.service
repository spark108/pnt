[Unit]
Description=PNT decentralized cluster node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/default/pnt
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/pnt/.net
ExecStart=/usr/local/bin/pnt serve
ExecStartPre=/usr/local/bin/pnt _prepare-access
Restart=on-failure
RestartSec=3
WorkingDirectory=/var/lib/pnt
StateDirectory=pnt
StateDirectoryMode=2770
UMask=0007
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
